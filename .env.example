NEXT_PUBLIC_APP_NAME_AR="نيكس جين سولوشنز"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_COMPANY_EMAIL=""
NEXT_PUBLIC_SAUDI_PHONE=""
