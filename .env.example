NEXT_PUBLIC_BUSINESS_ADDRESS_AR=""
NEXT_PUBLIC_BUSINESS_ADDRESS_EN=""
NEXT_PUBLIC_WORKING_HOURS_AR=""
NEXT_PUBLIC_WORKING_HOURS_EN=""
NEXT_PUBLIC_BOOKING_URL=""
