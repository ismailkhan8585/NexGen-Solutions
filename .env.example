# Server-only secrets — replace locally or in the deployment dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Optional HTTPS endpoint notified after a lead is successfully stored. The payload
# contains only the reference number, locale, and service — never the full enquiry.
INQUIRY_WEBHOOK_URL=""

# Public business identity. These values are safe to render in the website.
